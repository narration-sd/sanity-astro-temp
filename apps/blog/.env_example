# these you arrange on your sanity.io/manage login

# n.b. duplicated elements are to fit Sanity or plaform Studio deployment


PUBLIC_SANITY_PROJECT_ID='your-projrctId'
SANITY_STUDIO+PROJECT_ID='your-projrctId'
PUBLIC_SANITY_DATASET='your-dataset'
SANITY_STUDIO_DATASET='your-dataset'

PUBLIC_SANITY_API_READ_TOKEN='your-viewer-token'
PUBLIC_SANITY_API_VERSION='v2024-05-25'

# this is the full http:/https: url for this app where you're running it, dev or deploy
PUBLIC_SANITY_STUDIO_PREVIEW_URL='your-dev-or-deployment-url'

# choose Visual Editing settings here
PUBLIC_SANITY_STUDIO_BASE_PATH='/admin'
PUBLIC_SANITY_VISUAL_EDITING='true'
PUBLIC_SANITY_VISUAL_EDITING_ENABLED='true'

# these are or have been in local development variants
PUBLIC_SANITY_FULL_RENDER_DELAY=30